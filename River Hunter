----------------------------------------------------------------------
-- HOOKSET FUNCTION WITH CONFIGURABLE DELAY (ตวัดเบ็ดแบบตั้งดีเลย์ได้)
----------------------------------------------------------------------
local lastHooksetTime = 0
local isHooksetting = false

local function triggerHookset()
    local now = os.clock()
    if isHooksetting or (now - lastHooksetTime < 0.35) then return end
    isHooksetting = true
    lastHooksetTime = now

    task.spawn(function()
        local delayVal = (Options.HooksetDelay and Options.HooksetDelay.Value) or 0
        if delayVal > 0 then
            task.wait(delayVal)
        end

        -- 1. ยิง Remote คำสั่ง hookset ไปยังเซิร์ฟเวอร์
        if InputRemote then
            InputRemote:FireServer("hookset")
        end

        -- 2. จำลองการกดปุ่ม E เพื่อให้แอนิเมชันและไคลเอนต์ทำงานสอดคล้องกันทันที
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

        task.wait(0.15)
        isHooksetting = false
    end)
end

