local function getCastButton()
    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    if pgui then
        local fishingUI = pgui:FindFirstChild("FishingUI")
        if fishingUI then
            local reel = fishingUI:FindFirstChild("Reel")
            if reel then
                return reel:FindFirstChild("Main")
            end
        end
    end
    return nil
end

-- เวลากดค้างชาร์จแรงโยน (วินาที) ตามระยะที่เลือก
local CAST_HOLD_PRESETS = {
    ["ใกล้ (Near)"] = 0.20,
    ["กลาง (Medium)"] = 0.38,
    ["ไกล (Far / Perfect)"] = 0.55, -- ค่าเดิมของสคริปต์ (ชาร์จถึงช่อง perfect)
}

local function getCastHold()
    local choice = Options.CastDistance and Options.CastDistance.Value
    if choice == "กำหนดเอง (Custom)" then
        local v = Options.CastHold and tonumber(Options.CastHold.Value)
        if v then
            return math.clamp(v, 0.05, 1.5)
        end
    end
    return CAST_HOLD_PRESETS[choice] or 0.55
end

local function performCast()
    local btn = getCastButton()
    if btn then
        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
        task.wait(getCastHold()) -- charge time = cast distance
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    end
end

-- ควบคุมการเอียงคันเบ็ด (Steer / Tilt Rod)
local currentSteer = 0
local function updateSteer(targetSteer)
    if currentSteer == targetSteer then return end
    currentSteer = targetSteer

    if InputRemote then
        InputRemote:FireServer("steer", targetSteer)
    end

    -- จำลองการกดปุ่ม A / D ให้ตัวละครเอียงคันเบ็ดตามทิศทาง
    if targetSteer > 0 then
        -- เอียงขวา (Tilt Right)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.A, false, game)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.D, false, game)
    elseif targetSteer < 0 then
        -- เอียงซ้าย (Tilt Left)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.D, false, game)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.A, false, game)
    else
        -- คืนตำแหน่งตรงกลาง
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.A, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.D, false, game)
    end
end

----------------------------------------------------------------------
-- AUTO FISH & FIGHT BACKGROUND LOOP
----------------------------------------------------------------------
-- ส่งคำสั่งสู้ปลา: ดึง (pull) กับ กรอ (reel) ไม่ทำพร้อมกัน เว้นแต่ปลาหมดแรง
local function fightInput(pullRate, exhausted)
    if not InputRemote then return end

    local noReel = Options.NoReelTug and Options.NoReelTug.Value
    if not noReel or exhausted then
        -- แบบเดิม (หรือปลาหมดแรงแล้ว สายปลอดภัย): ดึงพร้อมกรอ
        InputRemote:FireServer("pull", pullRate)
        InputRemote:FireServer("reel", 1)
        return
    end

    local reelBelow = Options.ReelBelowTension and Options.ReelBelowTension.Value or 0.5
    local slack = fightState.tension <= reelBelow
        and not fightState.isBurst and not fightState.isSurge and not fightState.isSnagged
    if slack then
        -- สายหย่อน: กรอสายเข้าอย่างเดียว ไม่ดึง
        InputRemote:FireServer("reel", 1)
    else
        -- ดึงสู้ปลา: ปล่อยรอกไว้ ไม่กรอ
        InputRemote:FireServer("pull", pullRate)
        InputRemote:FireServer("reel", 0)
    end
end

local lastJerkTime = 0
local lastCastTime = 0

task.spawn(function()
    while true do
        task.wait(0.05) -- Fast non-blocking tick (50ms)
        if Fluent.Unloaded then break end

        if not Options.AutoFish or not Options.AutoFish.Value then
            if currentSteer ~= 0 then
                updateSteer(0)
            end
            continue
        end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then continue end

        -- ตรวจสอบและถือคันเบ็ด
        local rodInHand = char:FindFirstChild("คันเบ็ด") or char:FindFirstChildOfClass("Tool")
        if not rodInHand then
            local rodInBag = LocalPlayer.Backpack:FindFirstChild("คันเบ็ด")
            if rodInBag then
                hum:EquipTool(rodInBag)
                task.wait(0.4)
            end
        end

        local phase = LocalPlayer:GetAttribute("FishPhase") or "idle"
        local now = os.clock()

        -- Auto Sell check (เมื่ออยู่ในสถานะว่าง idle)
        if Options.AutoSell and Options.AutoSell.Value and phase == "idle" then
            local bucketN = tonumber(LocalPlayer:GetAttribute("BucketN")) or 0
            local target = tonumber(Options.SellThreshold.Value) or 15
            if bucketN >= target then
                if InputRemote then
                    InputRemote:FireServer("sell", {all = true})
                    task.wait(0.8)
                end
            end
        end

        if phase == "idle" then
            if currentSteer ~= 0 then
                updateSteer(0)
            end
            if now - lastCastTime > 1.2 then
                lastCastTime = now
                performCast()
            end

        elseif phase == "flight" or phase == "pending" then
            lastJerkTime = now
            if currentSteer ~= 0 then
                updateSteer(0)
            end

        elseif phase == "lure" then
            if currentSteer ~= 0 then
                updateSteer(0)
            end

            -- 1. Auto Jerk / Twitch (กระตุกเหยื่อ - กด E)
            if Options.AutoJerk and Options.AutoJerk.Value then
                local jDelay = Options.JerkDelay and Options.JerkDelay.Value or 1.5
                if now - lastJerkTime >= jDelay then
                    lastJerkTime = now
                    if InputRemote then
                        InputRemote:FireServer("jerk")
                    end
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.defer(function()
                        task.wait(0.02)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    end)
                end
            end

            -- 2. Auto Reel (กรอสายล่อปลา)
            if Options.AutoReelLure and Options.AutoReelLure.Value then
                local rSpeed = Options.ReelSpeed and Options.ReelSpeed.Value or 0.7
                if InputRemote then
                    InputRemote:FireServer("reel", rSpeed)
                end
            else
                if InputRemote then
                    InputRemote:FireServer("reel", 0)
                end
            end

        elseif phase == "strike" then
            triggerHookset()

        elseif phase == "fight" then
            local smartFight = Options.SmartFight and Options.SmartFight.Value
            local maxTension = Options.MaxTension and Options.MaxTension.Value or 0.85
            local autoSteer = Options.AutoSteer and Options.AutoSteer.Value

            -- [1] AUTO TILT / STEER (เอียงคันเบ็ด ซ้าย-ขวา)
            if autoSteer then
                if fightState.isSnagged then
                    -- ติดตอ (Snagged): เอียงตามทิศทางปลดตอ
                    if fightState.snagDir < 0 then
                        updateSteer(-1)
                    elseif fightState.snagDir > 0 then
                        updateSteer(1)
                    end
                elseif fightState.gaveUp then
                    updateSteer(0)
                else
                    local ld = fightState.lateralDir
                    if ld < -0.06 then
                        updateSteer(1)  -- ปลาว่ายไปซ้าย -> เอียงคันสวนไปทางขวา ▶
                    elseif ld > 0.06 then
                        updateSteer(-1) -- ปลาว่ายไปขวา -> เอียงคันสวนไปทางซ้าย ◀
                    else
                        updateSteer(0)
                    end
                end
            end

            -- [2] SMART ANTI-SNAP (ป้องกันสายขาด)
            if smartFight then
                local isDanger = (fightState.tension >= maxTension) or fightState.isBurst or fightState.isSurge or fightState.isSnagged
                local isExhausted = fightState.gaveUp or (fightState.fishStamina <= 0.2 and not fightState.isBurst)

                if isDanger and not isExhausted then
                    -- ผ่อนรอกทันทีเพื่อป้องกันสายขาด!
                    if InputRemote then
                        InputRemote:FireServer("reel", 0)
                    end
                    task.wait(0.04)
                else
                    -- ปลอดภัย / ปลาเริ่มหมดแรง: กรอสายและดึงสู้ปลา
                    local pullRate = (Options.FastTug and Options.FastTug.Value) and 0.07 or 0.12
                    fightInput(pullRate, isExhausted)
                end
            else
                local pullRate = (Options.FastTug and Options.FastTug.Value) and 0.07 or 0.12
                fightInput(pullRate, false)
            end

        elseif phase == "landing" then
            if currentSteer ~= 0 then
                updateSteer(0)
            end
            if InputRemote then
                InputRemote:FireServer("land")
                InputRemote:FireServer("reel", 0)
            end
        end
    end
end)

