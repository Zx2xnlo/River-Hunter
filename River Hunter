-- TAB 2: TWEEN TRAVEL (ระบบทวีนเดินทางลอยไปแต่ละจุด)
----------------------------------------------------------------------
do
    Tabs.Teleport:AddParagraph({
        Title = "ระบบทวีนเดินทาง (Tween System)",
        Content = "เดินทางไปยังจุดต่าง ๆ อย่างนุ่มนวลด้วย TweenService พร้อมระบบ Noclip ลอยทะลุสิ่งกีดขวาง ไม่หลุดตกแมพ และไม่โดนระบบตรวจสอบระยะทาง"
    })

    local TweenSpeedSlider = Tabs.Teleport:AddSlider("TweenSpeed", {
        Title = "Tween Speed (ความเร็วการทวีน)",
        Description = "ความเร็วในการบิน/ทวีนไปยังจุดหมาย (Studs/วินาที)",
        Default = 60,
        Min = 20,
        Max = 150,
        Rounding = 0
    })

    local locations = {
        ["ตลาดปลา (Fish Market)"] = Vector3.new(-31.6, 7.4, 197.8),
        ["ท่าเรือแพตกปลา (Bait Raft Pier)"] = Vector3.new(-8.6, 4.5, 73.1),
        ["ร้านก๋วยเตี๋ยวริมน้ำ (Noodle Landing)"] = Vector3.new(29.6, 3.5, 180),
