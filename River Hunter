        ["แม่น้ำสายหลัก (Main River)"] = Vector3.new(0, 5, 800),
        ["แม่น้ำตอนล่าง (Downstream)"] = Vector3.new(0, 5, 1200)
    }

    local locationKeys = {
        "ตลาดปลา (Fish Market)",
        "ท่าเรือแพตกปลา (Bait Raft Pier)",
        "ร้านก๋วยเตี๋ยวริมน้ำ (Noodle Landing)",
        "อ่างเก็บน้ำ (Reservoir)",
        "สันเขื่อน (Dam Crest)",
        "ร้านกาแฟริมทาง (Coffee Shop)",
        "แม่น้ำสายหลัก (Main River)",
        "แม่น้ำตอนล่าง (Downstream)",
        "บ้านของฉัน (My Plot)"
    }

    local ZoneDropdown = Tabs.Teleport:AddDropdown("ZoneSelect", {
        Title = "เลือกจุดหมาย",
        Values = locationKeys,
        Multi = false,
        Default = "ตลาดปลา (Fish Market)"
    })

    -- ตัวแปรควบคุมการทวีน
    local currentTween = nil
    local isTweening = false
    local currentBV = nil
    local noclipConn = nil

    local function stopTween()
        if currentTween then
            currentTween:Cancel()
            currentTween = nil
        end
        isTweening = false
        if currentBV and currentBV.Parent then
            currentBV:Destroy()
            currentBV = nil
        end
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
        -- คืนค่าการชนกันของตัวละคร
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end

    local function tweenTo(targetCFrame)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        stopTween()

        local speed = (Options.TweenSpeed and Options.TweenSpeed.Value) or 60
        local distance = (targetCFrame.Position - hrp.Position).Magnitude
        local duration = math.max(0.2, distance / speed)

        -- ตรึงความเร็วป้องกันตัวละครตกลงสู่พื้นขณะทวีน
        currentBV = Instance.new("BodyVelocity")
        currentBV.Velocity = Vector3.new(0, 0, 0)
        currentBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        currentBV.Parent = hrp

        isTweening = true

        -- ระบบ Noclip ขณะทวีน เพื่อให้ลอยทะลุต้นไม้ หิน สิ่งปลูกสร้างได้นุ่มนวล
        noclipConn = RunService.Stepped:Connect(function()
            if not isTweening or not char then
                if noclipConn then noclipConn:Disconnect() noclipConn = nil end
                return
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)

        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})

        currentTween.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then
                Fluent:Notify({
                    Title = "การเดินทาง",
                    Content = "ทวีนถึงจุดหมายเรียบร้อยแล้ว!",
                    Duration = 3
                })
            end
            stopTween()
        end)

        currentTween:Play()

        Fluent:Notify({
            Title = "กำลังทวีน...",
            Content = string.format("ระยะทาง: %.0f studs (ใช้เวลา ~%.1f วิ)", distance, duration),
            Duration = 3
        })
    end

    Tabs.Teleport:AddButton({
        Title = "ทวีนไปยังจุดที่เลือก (Start Tween)",
        Callback = function()
            local selected = Options.ZoneSelect.Value
            if selected == "บ้านของฉัน (My Plot)" then
                local plotNum = LocalPlayer:GetAttribute("Plot")
                local plot = workspace:FindFirstChild("Town") and workspace.Town:FindFirstChild("Plots") and workspace.Town.Plots:FindFirstChild("Plot" .. tostring(plotNum))
                if plot then
                    tweenTo(plot:GetPivot() + Vector3.new(0, 3, 0))
                else
                    Fluent:Notify({ Title = "Tween", Content = "ไม่พบตำแหน่งแปลงที่ดิน", Duration = 3 })
                end
            elseif locations[selected] then
                tweenTo(CFrame.new(locations[selected]))
            end
        end
    })

    Tabs.Teleport:AddButton({
        Title = "หยุดทวีน (Stop / Cancel Tween)",
        Description = "กดยกเลิกการทวีนค้างกลางทางทันที",
        Callback = function()
            stopTween()
            Fluent:Notify({ Title = "Tween", Content = "ยกเลิกการทวีนเรียบร้อยแล้ว", Duration = 2 })
        end
    })

    Tabs.Teleport:AddButton({
        Title = "ทวีนไปตลาดปลาทันที (Quick Market)",
        Callback = function()
            tweenTo(CFrame.new(locations["ตลาดปลา (Fish Market)"]))
        end
    })

    Tabs.Teleport:AddButton({
        Title = "ทวีนกลับบ้านทันที (Quick Home)",
        Callback = function()
            local plotNum = LocalPlayer:GetAttribute("Plot")
            local plot = workspace:FindFirstChild("Town") and workspace.Town:FindFirstChild("Plots") and workspace.Town.Plots:FindFirstChild("Plot" .. tostring(plotNum))
            if plot then
                tweenTo(plot:GetPivot() + Vector3.new(0, 3, 0))
            end
        end
    })
end

